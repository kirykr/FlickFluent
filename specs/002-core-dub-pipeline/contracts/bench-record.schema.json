{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flickfluent/bench-record",
  "title": "BenchmarkRecord",
  "type": "object",
  "required": ["id", "createdAt", "machine", "fixture", "results", "verdict"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string" },
    "machine": {
      "type": "object",
      "required": ["os", "osVersion", "arch", "cpuModel", "cores", "ramGb", "freeDiskGb", "accelerator", "simulated"],
      "additionalProperties": false,
      "properties": {
        "os": { "type": "string" },
        "osVersion": { "type": ["string", "null"] },
        "arch": { "type": "string" },
        "cpuModel": { "type": ["string", "null"] },
        "cores": { "type": ["integer", "null"] },
        "ramGb": { "type": ["number", "null"] },
        "freeDiskGb": { "type": ["number", "null"] },
        "accelerator": { "enum": ["none", "appleSilicon", "discreteGpu", "unknown"] },
        "simulated": { "type": "boolean" },
        "simulatedLimits": {
          "type": "object",
          "required": ["cpuCores", "ramGb"],
          "additionalProperties": false,
          "properties": {
            "cpuCores": { "type": "integer", "minimum": 1 },
            "ramGb": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "fixture": {
      "type": "object",
      "required": ["id", "durationMs"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "durationMs": { "type": "integer", "minimum": 1 }
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["stage", "modelId", "wallMs", "peakRamMb", "realTimeFactor"],
        "additionalProperties": false,
        "properties": {
          "stage": { "enum": ["extract", "separate", "transcribe", "translate", "synthesize", "mix"] },
          "modelId": { "type": "string" },
          "wallMs": { "type": "integer", "minimum": 0 },
          "peakRamMb": { "type": ["integer", "null"], "minimum": 0 },
          "realTimeFactor": { "type": "number", "minimum": 0 }
        }
      }
    },
    "verdict": {
      "type": "object",
      "required": ["canRunMinimum", "canRunFullLocal", "notes"],
      "additionalProperties": false,
      "properties": {
        "canRunMinimum": { "type": "boolean" },
        "canRunFullLocal": { "type": "boolean" },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
