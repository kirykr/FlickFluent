{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flickfluent/cloud-services",
  "title": "CloudServices",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "steps",
      "needsRegion",
      "termsUrl",
      "dataNotice",
      "endpoints",
      "languages",
      "limits"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "steps": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "enum": [
            "translate",
            "speak"
          ]
        }
      },
      "needsRegion": {
        "type": "boolean"
      },
      "termsUrl": {
        "type": "string",
        "pattern": "^https://"
      },
      "dataNotice": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "translate": {
            "type": "string"
          },
          "speak": {
            "type": "string"
          }
        }
      },
      "endpoints": {
        "type": "object",
        "required": [
          "check"
        ],
        "additionalProperties": false,
        "properties": {
          "check": {
            "type": "string",
            "pattern": "^https://"
          },
          "translate": {
            "type": "string",
            "pattern": "^https://"
          },
          "speak": {
            "type": "string",
            "pattern": "^https://"
          },
          "voices": {
            "type": "string",
            "pattern": "^https://"
          },
          "languages": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      },
      "languages": {
        "type": "object",
        "required": [
          "checkedOn"
        ],
        "additionalProperties": false,
        "properties": {
          "translate": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "speak": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "checkedOn": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      },
      "models": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "translate": {
            "type": "string"
          },
          "speak": {
            "type": "string"
          }
        }
      },
      "voices": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "id",
            "gender"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "gender": {
              "enum": [
                "female",
                "male"
              ]
            }
          }
        }
      },
      "limits": {
        "type": "object",
        "required": [
          "batchLines",
          "batchChars"
        ],
        "additionalProperties": false,
        "properties": {
          "batchLines": {
            "type": "integer",
            "minimum": 1
          },
          "batchChars": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "_comment": {
        "type": "string"
      }
    }
  }
}
