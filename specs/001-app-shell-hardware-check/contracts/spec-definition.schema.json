{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flickfluent/spec-definition",
  "title": "SpecDefinition",
  "type": "object",
  "required": ["version", "provisional", "minimum", "fullLocal"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "provisional": { "type": "boolean" },
    "basis": { "enum": ["simulated", "measured"] },
    "minimum": { "$ref": "#/$defs/tier" },
    "fullLocal": { "$ref": "#/$defs/tier" }
  },
  "$defs": {
    "tier": {
      "type": "object",
      "required": ["cpuBits", "cpuCores", "ramGb", "freeDiskGb", "os", "accelerator"],
      "additionalProperties": false,
      "properties": {
        "cpuBits": { "const": 64 },
        "cpuCores": { "type": "integer", "minimum": 1 },
        "ramGb": { "type": "number", "minimum": 1 },
        "freeDiskGb": { "type": "number", "minimum": 1 },
        "os": {
          "type": "object",
          "required": ["windows", "macos"],
          "additionalProperties": false,
          "properties": {
            "windows": { "type": "string" },
            "macos": { "type": "string" }
          }
        },
        "accelerator": { "enum": ["none", "appleSilicon_or_discreteGpu"] }
      }
    }
  }
}
